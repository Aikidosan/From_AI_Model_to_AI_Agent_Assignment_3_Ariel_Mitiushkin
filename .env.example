# Customer Service Data Analyst Agent -- example environment file.
#
# Copy this file to ``.env`` (the real file is gitignored) and fill in
# the API key. Every other variable has a sensible default and can be
# omitted.
#
#   cp .env.example .env
#   # then edit .env and set NEBIUS_API_KEY=<your key>

# Required: API key for the Nebius Token Factory.
# Sign up and create a static key at https://studio.nebius.com .
NEBIUS_API_KEY=

# Optional overrides (uncomment to change). The defaults below are the
# values used when a variable is unset or empty.
#
# NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
# BITEXT_DATASET_PATH=./data/bitext_customer_service.csv
# CHECKPOINT_DB=./checkpoints.db
# PROFILE_DIR=./profiles
# MAX_ITERATIONS=15
#
# MCP server only:
# MCP_TRANSPORT=stdio   # or "sse"
# MCP_HOST=0.0.0.0      # used when MCP_TRANSPORT=sse
# MCP_PORT=8000         # used when MCP_TRANSPORT=sse
